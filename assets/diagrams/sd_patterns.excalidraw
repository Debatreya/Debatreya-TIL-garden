      "updated": 1777526535868,
      "link": null,
      "locked": false,
      "text": "A circuit breaker interface\ninstalled between any two nodes\ntracks the state of the node\nother depends on. Breaks the \ncircuit and Slows downrequests \nfrom dependent node, gives time \nto the node to recover",
      "fontSize": 14.933179723502304,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A circuit breaker interface\ninstalled between any two nodes\ntracks the state of the node\nother depends on. Breaks the \ncircuit and Slows downrequests \nfrom dependent node, gives time \nto the node to recover",
      "autoResize": true,
      "lineHeight": 1.25
    },
